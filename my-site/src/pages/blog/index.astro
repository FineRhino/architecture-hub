---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import Sidebar from '../../components/Sidebar.astro';
import Icon from '../../components/Icon.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Articles | ${SITE_TITLE}`} description="Insights, case studies, and deep dives into enterprise AI architecture" />
		<style>
			.post-grid {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			.post-grid li {
				width: calc(50% - 1rem);
			}
			.post-grid li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			.post-grid li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			.post-grid li:first-child img {
				width: 100%;
			}
			.post-grid li:first-child .title {
				font-size: 2.369rem;
			}
			.post-grid li img {
				margin-bottom: 0.5rem;
				border-radius: var(--radius-md);
			}
			.post-grid li a {
				display: block;
			}
			.post-title {
				margin: 0;
				color: var(--text-primary);
				line-height: 1.2;
			}
			.post-date {
				margin: 0;
				color: var(--text-muted);
			}
			.post-grid li a:hover .post-title,
			.post-grid li a:hover .post-date {
				color: var(--accent);
			}
			.post-grid a:hover img {
				box-shadow: var(--shadow-md);
			}
			@media (max-width: 720px) {
				.post-grid {
					gap: 0.5em;
				}
				.post-grid li {
					width: 100%;
					text-align: center;
				}
				.post-grid li:first-child {
					margin-bottom: 0;
				}
				.post-grid li:first-child .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="listing-main">
			<div class="page-hero">
				<span class="icon-badge is-blog"><Icon name="document" size={26} /></span>
				<h1>Articles</h1>
				<p>Insights, case studies, and deep dives into enterprise AI architecture</p>
			</div>

			<div class="site-shell">
				<Sidebar />
				<div class="site-content">
					<div class="listing-content">
						{posts.length === 0 ? (
							<p class="empty-state">No articles published yet. Check back soon!</p>
						) : (
							<ul class="post-grid">
								{posts.map((post) => (
									<li>
										<a href={`/blog/${post.id}/`}>
											{post.data.heroImage && (
												<Image width={720} height={360} src={post.data.heroImage} alt="" />
											)}
											<h4 class="post-title">{post.data.title}</h4>
											<p class="post-date">
												<FormattedDate date={post.data.pubDate} />
											</p>
										</a>
									</li>
								))}
							</ul>
						)}
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

---
export type IconName =
	| 'layers'
	| 'sliders'
	| 'compass'
	| 'document'
	| 'arrow-right'
	| 'external-link'
	| 'clock'
	| 'rocket'
	| 'network'
	| 'search'
	| 'gauge'
	| 'link'
	| 'bar-chart'
	| 'mark';

interface Props {
	name: IconName;
	size?: number;
	class?: string;
}

const { name, size = 24, class: className = '' } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
>
	{name === 'layers' && (
		<>
			<polygon points="12,3 21,8.5 12,14 3,8.5" />
			<polyline points="3,14.5 12,20 21,14.5" />
		</>
	)}
	{name === 'sliders' && (
		<>
			<line x1="4" y1="6" x2="20" y2="6" />
			<circle cx="9" cy="6" r="2" fill="var(--icon-fill, #fff)" />
			<line x1="4" y1="12" x2="20" y2="12" />
			<circle cx="15" cy="12" r="2" fill="var(--icon-fill, #fff)" />
			<line x1="4" y1="18" x2="20" y2="18" />
			<circle cx="7" cy="18" r="2" fill="var(--icon-fill, #fff)" />
		</>
	)}
	{name === 'compass' && (
		<>
			<circle cx="12" cy="12" r="9" />
			<polygon points="15,9 13,13 9,15 11,11" fill="currentColor" stroke="none" />
		</>
	)}
	{name === 'document' && (
		<>
			<rect x="5" y="4" width="14" height="16" rx="2" />
			<line x1="8" y1="9" x2="16" y2="9" />
			<line x1="8" y1="13" x2="16" y2="13" />
			<line x1="8" y1="17" x2="13" y2="17" />
		</>
	)}
	{name === 'arrow-right' && (
		<>
			<line x1="4" y1="12" x2="18" y2="12" />
			<polyline points="12,6 18,12 12,18" />
		</>
	)}
	{name === 'external-link' && (
		<>
			<rect x="4" y="4" width="12" height="12" rx="1.5" />
			<polyline points="14,3 21,3 21,10" />
			<line x1="21" y1="3" x2="11" y2="13" />
		</>
	)}
	{name === 'clock' && (
		<>
			<circle cx="12" cy="12" r="9" />
			<polyline points="12,7 12,12 16,14" />
		</>
	)}
	{name === 'rocket' && (
		<>
			<polygon points="12,3 16,15 8,15" />
			<circle cx="12" cy="10" r="1.4" fill="currentColor" stroke="none" />
			<line x1="9" y1="15" x2="7" y2="20" />
			<line x1="15" y1="15" x2="17" y2="20" />
		</>
	)}
	{name === 'network' && (
		<>
			<circle cx="6" cy="6" r="2" />
			<circle cx="18" cy="6" r="2" />
			<circle cx="12" cy="18" r="2" />
			<line x1="7" y1="7.5" x2="11" y2="16" />
			<line x1="17" y1="7.5" x2="13" y2="16" />
			<line x1="8" y1="6" x2="16" y2="6" />
		</>
	)}
	{name === 'search' && (
		<>
			<circle cx="10" cy="10" r="6" />
			<line x1="14.5" y1="14.5" x2="20" y2="20" />
		</>
	)}
	{name === 'gauge' && (
		<>
			<circle cx="12" cy="13" r="7" />
			<line x1="12" y1="13" x2="15" y2="9" />
			<line x1="8" y1="4.5" x2="8.6" y2="6.1" />
			<line x1="16" y1="4.5" x2="15.4" y2="6.1" />
		</>
	)}
	{name === 'link' && (
		<>
			<rect x="3" y="9" width="8" height="6" rx="3" />
			<rect x="13" y="9" width="8" height="6" rx="3" />
		</>
	)}
	{name === 'bar-chart' && (
		<>
			<line x1="5" y1="19" x2="5" y2="12" />
			<line x1="12" y1="19" x2="12" y2="7" />
			<line x1="19" y1="19" x2="19" y2="14" />
			<line x1="3" y1="19" x2="21" y2="19" />
		</>
	)}
	{name === 'mark' && (
		<>
			<polygon points="12,3 21,8.5 12,14 3,8.5" fill="currentColor" stroke="none" opacity="0.55" />
			<polyline points="3,14.5 12,20 21,14.5" />
		</>
	)}
</svg>
